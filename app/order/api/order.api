syntax = "v1"

type BaseResp {
	Code int32  `json:"code"`
	Msg  string `json:"msg"`
}

type CartItemInfo {
	Id            int64  `json:"id"`
	ProductId     int64  `json:"product_id"`
	ProductName   string `json:"product_name"`
	ProductCover  string `json:"product_cover"`
	Price         int64  `json:"price"`
	Stock         int32  `json:"stock"`
	Quantity      int32  `json:"quantity"`
	Selected      int32  `json:"selected"`
	ProductStatus int32  `json:"product_status"`
	CreatedAt     int64  `json:"created_at"`
	UpdatedAt     int64  `json:"updated_at"`
}

type CartListData {
	List  []CartItemInfo `json:"list"`
	Total int64          `json:"total"`
}

type CartListResp {
	Code int32        `json:"code"`
	Msg  string       `json:"msg"`
	Data CartListData `json:"data"`
}

type AddCartReq {
	ProductId int64 `json:"product_id" validate:"required"`
	Quantity  int32 `json:"quantity" validate:"required"`
}

type UpdateCartReq {
	Id       int64 `path:"id"`
	Quantity int32 `json:"quantity,optional"`
	Selected int32 `json:"selected,optional"`
}

type CartItemReq {
	Id int64 `path:"id"`
}

type SelectCartReq {
	Selected int32 `json:"selected"`
}

type CartItemResp {
	Code int32        `json:"code"`
	Msg  string       `json:"msg"`
	Data CartItemInfo `json:"data"`
}

type OrderItemInfo {
	Id           int64  `json:"id"`
	ProductId    int64  `json:"product_id"`
	ProductName  string `json:"product_name"`
	ProductCover string `json:"product_cover"`
	Price        int64  `json:"price"`
	Quantity     int32  `json:"quantity"`
	TotalAmount  int64  `json:"total_amount"`
}

type OrderInfo {
	Id                 int64           `json:"id"`
	OrderNo            string          `json:"order_no"`
	UserId             int64           `json:"user_id"`
	TotalAmount        int64           `json:"total_amount"`
	FreightAmount      int64           `json:"freight_amount"`
	DiscountAmount     int64           `json:"discount_amount"`
	PayAmount          int64           `json:"pay_amount"`
	Status             int32           `json:"status"`
	PayType            int32           `json:"pay_type"`
	TransactionId      string          `json:"transaction_id"`
	ReceiverName       string          `json:"receiver_name"`
	ReceiverPhone      string          `json:"receiver_phone"`
	ReceiverProvince   string          `json:"receiver_province"`
	ReceiverCity       string          `json:"receiver_city"`
	ReceiverDistrict   string          `json:"receiver_district"`
	ReceiverAddress    string          `json:"receiver_address"`
	ReceiverPostalCode string          `json:"receiver_postal_code"`
	Remark             string          `json:"remark"`
	AdminRemark        string          `json:"admin_remark"`
	LogisticsCompany   string          `json:"logistics_company"`
	TrackingNo         string          `json:"tracking_no"`
	PaidAt             int64           `json:"paid_at"`
	ShippedAt          int64           `json:"shipped_at"`
	CompletedAt        int64           `json:"completed_at"`
	CanceledAt         int64           `json:"canceled_at"`
	CancelReason       string          `json:"cancel_reason"`
	CreatedAt          int64           `json:"created_at"`
	UpdatedAt          int64           `json:"updated_at"`
	Items              []OrderItemInfo `json:"items"`
}

type OrderResp {
	Code int32     `json:"code"`
	Msg  string    `json:"msg"`
	Data OrderInfo `json:"data"`
}

type CreateOrderReq {
	AddressId int64  `json:"address_id" validate:"required"`
	Remark    string `json:"remark,optional"`
	BuyNow    int32  `json:"buy_now,optional"`
	ProductId int64  `json:"product_id,optional"`
	Quantity  int32  `json:"quantity,optional"`
}

type GetOrderReq {
	Id int64 `path:"id"`
}

type OrderTrack {
	Time        int64  `json:"time"`
	Status      string `json:"status"`
	Description string `json:"description"`
}

type OrderTracksData {
	OrderId          int64        `json:"order_id"`
	OrderNo          string       `json:"order_no"`
	LogisticsCompany string       `json:"logistics_company"`
	TrackingNo       string       `json:"tracking_no"`
	Tracks           []OrderTrack `json:"tracks"`
}

type OrderTracksResp {
	Code int32           `json:"code"`
	Msg  string          `json:"msg"`
	Data OrderTracksData `json:"data"`
}

type ListOrdersReq {
	Page      int32  `form:"page,default=1"`
	PageSize  int32  `form:"page_size,default=10"`
	OrderNo   string `form:"order_no,optional"`
	Status    int32  `form:"status,optional"`
	UserId    int64  `form:"user_id,optional"`
	StartTime int64  `form:"start_time,optional"`
	EndTime   int64  `form:"end_time,optional"`
}

type OrderListData {
	List     []OrderInfo `json:"list"`
	Total    int64       `json:"total"`
	Page     int32       `json:"page"`
	PageSize int32       `json:"page_size"`
}

type OrderListResp {
	Code int32         `json:"code"`
	Msg  string        `json:"msg"`
	Data OrderListData `json:"data"`
}

type PayOrderReq {
	Id int64 `path:"id"`
}

type CancelOrderReq {
	Id     int64  `path:"id"`
	Reason string `json:"reason,optional"`
}

type ConfirmOrderReq {
	Id int64 `path:"id"`
}

type ShipOrderReq {
	Id               int64  `path:"id"`
	LogisticsCompany string `json:"logistics_company" validate:"required"`
	TrackingNo       string `json:"tracking_no" validate:"required"`
}

type DashboardData {
	TodayOrderCount      int64 `json:"today_order_count"`
	TodayPaidAmount      int64 `json:"today_paid_amount"`
	PendingShipmentCount int64 `json:"pending_shipment_count"`
	ProductCount         int64 `json:"product_count"`
	LowStockCount        int64 `json:"low_stock_count"`
}

type DashboardResp {
	Code int32         `json:"code"`
	Msg  string        `json:"msg"`
	Data DashboardData `json:"data"`
}

type PathIdReq {
	Id int64 `path:"id"`
}

type AfterSaleInfo {
	Id               int64    `json:"id"`
	AfterSaleNo      string   `json:"after_sale_no"`
	OrderId          int64    `json:"order_id"`
	OrderItemId      int64    `json:"order_item_id"`
	UserId           int64    `json:"user_id"`
	Type             int32    `json:"type"`
	Reason           string   `json:"reason"`
	Description      string   `json:"description"`
	Images           []string `json:"images"`
	Amount           int64    `json:"amount"`
	Status           int32    `json:"status"`
	AdminRemark      string   `json:"admin_remark"`
	TrackingNo       string   `json:"tracking_no"`
	ApplyAt          int64    `json:"apply_at"`
	ReviewAt         int64    `json:"review_at"`
	BuyerShippedAt   int64    `json:"buyer_shipped_at"`
	SellerReceivedAt int64    `json:"seller_received_at"`
	RefundedAt       int64    `json:"refunded_at"`
	CreatedAt        int64    `json:"created_at"`
	UpdatedAt        int64    `json:"updated_at"`
	OrderNo          string   `json:"order_no"`
	ProductName      string   `json:"product_name"`
	ProductCover     string   `json:"product_cover"`
}

type ApplyAfterSaleReq {
	OrderId     int64    `json:"order_id" validate:"required"`
	OrderItemId int64    `json:"order_item_id,optional"`
	Type        int32    `json:"type" validate:"required"`
	Reason      string   `json:"reason" validate:"required"`
	Description string   `json:"description,optional"`
	Images      []string `json:"images,optional"`
}

type AfterSaleReq {
	Id int64 `path:"id"`
}

type AfterSaleResp {
	Code int32         `json:"code"`
	Msg  string        `json:"msg"`
	Data AfterSaleInfo `json:"data"`
}

type ListAfterSalesReq {
	Page     int32 `form:"page,default=1"`
	PageSize int32 `form:"page_size,default=10"`
	Status   int32 `form:"status,optional"`
}

type AfterSaleListData {
	List     []AfterSaleInfo `json:"list"`
	Total    int64           `json:"total"`
	Page     int32           `json:"page"`
	PageSize int32           `json:"page_size"`
}

type AfterSaleListResp {
	Code int32             `json:"code"`
	Msg  string            `json:"msg"`
	Data AfterSaleListData `json:"data"`
}

type HandleAfterSaleReq {
	Id          int64  `path:"id"`
	Action      string `json:"action" validate:"required"`
	AdminRemark string `json:"admin_remark,optional"`
	TrackingNo  string `json:"tracking_no,optional"`
}

type ShipAfterSaleReq {
	Id         int64  `path:"id"`
	TrackingNo string `json:"tracking_no" validate:"required"`
}

service order-api {
	@handler ListCartHandler
	get /cart returns (CartListResp)

	@handler AddCartHandler
	post /cart/items (AddCartReq) returns (CartItemResp)

	@handler UpdateCartHandler
	put /cart/items/:id (UpdateCartReq) returns (CartItemResp)

	@handler DeleteCartHandler
	delete /cart/items/:id (CartItemReq) returns (BaseResp)

	@handler SelectCartHandler
	put /cart/select (SelectCartReq) returns (BaseResp)

	@handler CreateOrderHandler
	post /orders (CreateOrderReq) returns (OrderResp)

	@handler ListOrdersHandler
	get /orders (ListOrdersReq) returns (OrderListResp)

	@handler GetOrderHandler
	get /order/:id (GetOrderReq) returns (OrderResp)

	@handler GetOrderTracksHandler
	get /order/:id/tracks (GetOrderReq) returns (OrderTracksResp)

	@handler PayOrderHandler
	post /order/:id/pay (PayOrderReq) returns (OrderResp)

	@handler CancelOrderHandler
	post /order/:id/cancel (CancelOrderReq) returns (OrderResp)

	@handler ConfirmOrderHandler
	post /order/:id/confirm (ConfirmOrderReq) returns (OrderResp)

	@handler ApplyAfterSaleHandler
	post /after-sales (ApplyAfterSaleReq) returns (AfterSaleResp)

	@handler ListAfterSalesHandler
	get /after-sales (ListAfterSalesReq) returns (AfterSaleListResp)

	@handler GetAfterSaleHandler
	get /after-sales/:id (AfterSaleReq) returns (AfterSaleResp)

	@handler ShipAfterSaleHandler
	post /after-sales/:id/ship (ShipAfterSaleReq) returns (AfterSaleResp)
}

@server (
	middleware: AdminOnlyMiddleware
)
service order-api {
	@handler AdminListOrdersHandler
	get /admin/orders (ListOrdersReq) returns (OrderListResp)

	@handler AdminGetOrderHandler
	get /admin/order/:id (GetOrderReq) returns (OrderResp)

	@handler ShipOrderHandler
	post /admin/order/:id/ship (ShipOrderReq) returns (OrderResp)

	@handler DashboardHandler
	get /admin/dashboard returns (DashboardResp)

	@handler AdminListAfterSalesHandler
	get /admin/after-sales (ListAfterSalesReq) returns (AfterSaleListResp)

	@handler AdminGetAfterSaleHandler
	get /admin/after-sales/:id (AfterSaleReq) returns (AfterSaleResp)

	@handler HandleAfterSaleHandler
	post /admin/after-sales/:id/handle (HandleAfterSaleReq) returns (AfterSaleResp)

	@handler AdminGetOrderTracksHandler
	get /admin/order/:id/tracks (GetOrderReq) returns (OrderTracksResp)
}

@server (
	middleware: SuperAdminOnlyMiddleware
)
service order-api {
	@handler AdminCancelOrderHandler
	post /admin/order/:id/cancel (CancelOrderReq) returns (OrderResp)
}

